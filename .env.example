# Local Node processes; each service needs its own DATABASE_URL and PORT.
PORT=3000
IDENTITY_URL=http://localhost:3001
TRACEABILITY_URL=http://localhost:3002
APP_BASE_URL=http://localhost:5173
INTERNAL_AUTH_SECRET=replace-with-long-random-value
DATABASE_URL=mysql://identity:CHANGE_ME@localhost:3306/identity
# Optional, only for disposable regression tests:
# TEST_DATABASE_URL=mysql://eventore:CHANGE_ME@localhost:3306/eventore_test
# NODE_ENV=production requires HTTPS for the Secure session cookie.

LOGISTICS_URL=http://localhost:3003

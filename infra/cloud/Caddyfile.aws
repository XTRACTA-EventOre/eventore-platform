:80 {
  @untrusted not header X-EventOre-Origin {$ORIGIN_SECRET}
  respond @untrusted "Forbidden" 403
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
  }
  handle /api/* {
    reverse_proxy gateway:3000
  }
  handle {
    root * /srv
    route {
      try_files {path} /index.html
      @uncached path /index.html /sw.js
      header @uncached Cache-Control "no-cache"
      file_server
    }
  }
}

{$PUBLIC_HOST} {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
  }
  handle /api/* {
    reverse_proxy gateway:3000
  }
  handle {
    root * /srv
    @uncached path /index.html /sw.js
    header @uncached Cache-Control "no-cache"
    try_files {path} /index.html
    file_server
  }
}

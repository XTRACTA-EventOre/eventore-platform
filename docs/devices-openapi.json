{
  "openapi": "3.0.3",
  "info": {
    "title": "EventOre Devices",
    "version": "1.3.0",
    "description": "Ocho servicios con MySQL 8.4 independiente: Identity, Traceability, Logistics, Processing, Jewelry, Certification, Devices y Reporting. La cookie se obtiene mediante login. Los reportes de dispositivos usan Bearer propio. Los comandos conservan operationId y cuerpo ante fallos sin confirmación. Los ejemplos son datos de prueba, no credenciales."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "eventore_session"
      },
      "deviceBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Payload": {
        "type": "object",
        "required": [
          "mineralType",
          "weight",
          "weightUnit",
          "originEvidence"
        ],
        "properties": {
          "mineralType": {
            "type": "string"
          },
          "weight": {
            "type": "string",
            "example": "125.50",
            "description": "Exact positive decimal string: at most 35 integer digits and 30 fractional digits; INVALID_WEIGHT_PRECISION if exceeded.",
            "maxLength": 66
          },
          "weightUnit": {
            "type": "string",
            "enum": [
              "g",
              "kg",
              "t"
            ]
          },
          "originEvidence": {
            "type": "object",
            "required": [
              "reference",
              "source"
            ],
            "properties": {
              "reference": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            }
          },
          "location": {
            "type": "object",
            "nullable": true,
            "properties": {
              "latitude": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "longitude": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            }
          },
          "concessionId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        }
      },
      "Event": {
        "type": "object",
        "required": [
          "clientEventId",
          "eventType",
          "occurredAt",
          "dependencies",
          "payload"
        ],
        "properties": {
          "clientEventId": {
            "type": "string",
            "format": "uuid"
          },
          "eventType": {
            "type": "string",
            "enum": [
              "LotRegistered"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp, years 1000-9999 in UTC, at most six fractional second digits."
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Empty for LotRegistered in Sprint 1"
          },
          "payload": {
            "$ref": "#/components/schemas/Payload"
          }
        }
      },
      "Outcome": {
        "type": "object",
        "properties": {
          "clientEventId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "Accepted",
              "AlreadyProcessed",
              "Conflict",
              "Rejected"
            ]
          },
          "lotId": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  },

                          },
                          "active": {
                            "type": "boolean"
                          },
                          "connection": {
                            "type": "string"
                          },
                          "lastCommunication": {
                            "type": "string",
                            "nullable": true
                          },
                          "battery": {
                            "type": "string",
                            "nullable": true
                          },
                          "batteryCurrent": {
                            "type": "boolean"
                          },
                          "calibrations": {
                            "type": "array",
                            "items": {
                              "type": "object"
                            }
                          },
                          "alerts": {
                            "type": "array",
                            "items": {
                              "type": "object"
                            }
                          },
                          "readings": {
                            "type": "array",
                            "items": {
                              "type": "object"
                            }
                          },
                          "audit": {
                            "type": "array",
                            "items": {
                              "type": "object"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "devices": [
                    {
                      "deviceId": "22222222-2222-4222-8222-222222222222",
                      "serial": "SCALE-DEMO",
                      "name": "Balanza",
                      "lotId": "55555555-5555-4555-8555-555555555555",
                      "version": 1,
                      "active": true,
                      "connection": "Unconfirmed",
                      "lastCommunication": null,

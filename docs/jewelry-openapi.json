{
  "openapi": "3.0.3",
  "info": {
    "title": "EventOre Jewelry",
    "version": "1.3.0",
    "description": "Ocho servicios con MySQL 8.4 independiente: Identity, Traceability, Logistics, Processing, Jewelry, Certification, Devices y Reporting. La cookie se obtiene mediante login. Los reportes de dispositivos usan Bearer propio. Los comandos conservan operationId y cuerpo ante fallos sin confirmación. Los ejemplos son datos de prueba, no credenciales."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "eventore_session"
      },
      "deviceBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Payload": {
        "type": "object",
        "required": [
          "mineralType",
          "weight",
          "weightUnit",
          "originEvidence"
        ],
        "properties": {
          "mineralType": {
            "type": "string"
          },
          "weight": {
            "type": "string",
            "example": "125.50",
            "description": "Exact positive decimal string: at most 35 integer digits and 30 fractional digits; INVALID_WEIGHT_PRECISION if exceeded.",
            "maxLength": 66
          },
          "weightUnit": {
            "type": "string",
            "enum": [
              "g",
              "kg",
              "t"
            ]
          },
          "originEvidence": {
            "type": "object",
            "required": [
              "reference",
              "source"
            ],
            "properties": {
              "reference": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            }
          },
          "location": {
            "type": "object",
            "nullable": true,
            "properties": {
              "latitude": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "longitude": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            }
          },
          "concessionId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        }
      },
      "Event": {
        "type": "object",
        "required": [
          "clientEventId",
          "eventType",
          "occurredAt",
          "dependencies",
          "payload"
        ],
        "properties": {
          "clientEventId": {
            "type": "string",
            "format": "uuid"
          },
          "eventType": {
            "type": "string",
            "enum": [
              "LotRegistered"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp, years 1000-9999 in UTC, at most six fractional second digits."
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Empty for LotRegistered in Sprint 1"
          },
          "payload": {
            "$ref": "#/components/schemas/Payload"
          }
        }
      },
      "Outcome": {
        "type": "object",
        "properties": {
          "clientEventId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "Accepted",
              "AlreadyProcessed",
              "Conflict",
              "Rejected"
            ]
          },
          "lotId": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  },
  "paths": {
    "/jewelry/inventory": {
      "get": {
        "summary": "Inventario separado por procedencia y revisión",
        "tags": [
          "Jewelry"
        ],
        "description": "Inventario separado por procedencia y revisión",
        "responses": {
          "200": {
            "description": "Resultado confirmado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "materials": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "lotId": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "mineralType": {
                            "type": "string"
                          },
                          "category": {
                            "type": "string"
                          },
                          "source": {
                            "type": "string"
                          },
                          "quantityGrams": {
                            "type": "string"
                          },
                          "availableGrams": {
                            "type": "string"
                          },
                          "version": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "materials": [
                    {
                      "id": "33333333-3333-4333-8333-333333333333",
                      "lotId": "22222222-2222-4222-8222-222222222222",
                      "mineralType": "Gold",
                      "category": "Declared",
                      "source": "Lote recibido; revisar genealogía vigente",
                      "quantityGrams": "100000",
                      "availableGrams": "99000",
                      "version": 1
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "INVALID_INPUT",
                    "message": "Datos inválidos"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Autenticación requerida",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "UNAUTHORIZED",
                    "message": "Autenticación requerida"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Permiso u origen no autorizado",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "FORBIDDEN",
                    "message": "Permiso u origen no autorizado"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Recurso no visible para la organización",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "NOT_FOUND",
                    "message": "Recurso no visible para la organización"
                  }
                }
              }
            }
          },
          "409": {
            "description": "Estado, versión, evidencia o balance incompatible",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "CONFLICT",
                    "message": "Estado, versión, evidencia o balance incompatible"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Servicio u operación sin confirmar; conservar identificador original",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "SERVICE_UNAVAILABLE",
                    "message": "Servicio u operación sin confirmar; conservar identificador original"
                  }
                }
              }
            }
          }
        },
        "operationId": "get_jewelry_inventory",
        "x-permission": "inventory.manage"
      }
    },

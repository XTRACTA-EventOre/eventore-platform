                      }
                    }
                  }
                },
                "example": {
                  "id": "55555555-5555-4555-8555-555555555555",
                  "name": "Anillo",
                  "version": 1,
                  "composition": [
                    {
                      "materialId": "33333333-3333-4333-8333-333333333333",
                      "lotId": "22222222-2222-4222-8222-222222222222",
                      "quantityGrams": "10",
                      "category": "Declared",
                      "mineralType": "Gold"
                    }
                  ],
                  "history": []
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",

                    "concessions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "name": {
                            "type": "string"
                          },
                          "source": {
                            "type": "string"
                          },
                          "authorizationRef": {
                            "type": "string"
                          },
                          "polygon": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "latitude": {
                                  "type": "integer"
                                },
                                "longitude": {
                                  "type": "integer"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },

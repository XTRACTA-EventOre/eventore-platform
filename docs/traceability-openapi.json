                "example": {
                  "error": {
                    "code": "FORBIDDEN",
                    "message": "Permiso u origen no autorizado"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Recurso no visible para la organización",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "NOT_FOUND",

              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "certificateId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "status": {
                      "type": "string"
                    },
                    "version": {
                      "type": "integer"
                    },
                    "eligible": {
                      "type": "boolean"
                    },
                    "issues": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "lotId": {
                            "type": "string",
                            "format": "uuid"
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "certificateId": "55555555-5555-4555-8555-555555555555",
                  "status": "PendingReview",
                  "version": 1,
                  "eligible": false,
                  "issues": [
                    {
                      "code": "EVIDENCE_NOT_APPROVED",
                      "lotId": "22222222-2222-4222-8222-222222222222"
                    }

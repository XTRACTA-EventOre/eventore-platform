{
  "info": {
    "name": "EventOre Avance 4 ejecución reproducible",
    "description": "Colección para instalación desechable con cuentas *-smoke. No guarda contraseñas ni cookies. Definir baseUrl y password al ejecutar. Crea y revoca datos de prueba. La ejecución Newman es evidencia de la colección; no se afirma una captura de la aplicación gráfica Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Gateway health",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "health"
          ]
        },
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Gateway health: HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('Gateway disponible',()=>pm.expect(pm.response.json().service).to.eql('gateway'));"
            ]
          }
        }
      ]
    },

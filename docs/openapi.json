          },
          "409": {
            "description": "Versión/estado incompatible, último administrador o identificador reutilizado"
          },
          "503": {
            "description": "Operación no confirmada; reintentar conservando operationId y el cuerpo original"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "operationId": "33333333-3333-4333-8333-333333333333",
                "expectedVersion": 2,
                "handoverId": "55555555-5555-4555-8555-555555555555"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "lotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "description": "Requiere Registered, entrega vigente y destinatario autorizado, sin restricciones. Solo una aceptación por versión. Ante 503 conservar operationId y el cuerpo para reintentar."
      }
    },
    "/custody/lots/{lotId}": {
      "get": {
        "summary": "Consultar custodia y reconciliar confirmaciones pendientes",
        "tags": [
          "Logistics"
        ],
        "x-permission": "lots.read",
        "responses": {
          "200": {
            "description": "Operación confirmada",
            "content": {
              "application/json": {
                "example": {
                  "custody": {
                    "operationId": "33333333-3333-4333-8333-333333333333",
                    "lotId": "22222222-2222-4222-8222-222222222222",
                    "status": "InTransit",
                    "version": 3,
                    "actorId": "44444444-4444-4444-8444-444444444444",
                    "action": "CustodyAccepted",
                    "occurredAt": "2026-11-14T15:00:00.000Z",
                    "custodianUserId": "44444444-4444-4444-8444-444444444444",
                    "handoverId": "55555555-5555-4555-8555-555555555555"
                  },
                  "pending": []
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida"
          },
          "401": {
            "description": "Sesión requerida"
          },
          "403": {
            "description": "Origen o permiso no autorizado"
          },
          "404": {
            "description": "Recurso no visible en la organización"
          },
          "409": {
            "description": "Versión/estado incompatible, último administrador o identificador reutilizado"
          },
          "503": {
            "description": "Operación no confirmada; reintentar conservando operationId y el cuerpo original"
          }
        },
        "parameters": [
          {
            "name": "lotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    }
  }
}

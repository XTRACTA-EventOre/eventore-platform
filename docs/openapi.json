            "application/json": {
              "example": {
                "operationId": "33333333-3333-4333-8333-333333333333",
                "expectedVersion": 1,
                "recipientUserId": null
              }
            }
          }
        },
        "parameters": [
          {
            "name": "lotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/lots/{lotId}/operations": {
      "get": {
        "summary": "Historial, entrega disponible y restricciones activas",
        "tags": [
          "Traceability"
        ],
